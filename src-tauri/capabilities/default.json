{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the bar, dashboard and screen-area overlay",
  "windows": ["main", "dashboard", "ocr-overlay", "draw-canvas", "draw-toolbar"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "dialog:allow-open"
  ]
}
