{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sayzo",
  "version": "0.3.0",
  "identifier": "com.oph.sayzo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sayzo",
        "width": 660,
        "height": 58,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OPH",
    "copyright": "© 2026 OPH — https://github.com/op-h",
    "homepage": "https://github.com/op-h/sayzo",
    "shortDescription": "Natural offline read-aloud for any text on screen",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["models/**/*"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
